Algoritmo NumPositivo
	Definir num como entero;
	
	Escribir "Ingrese el número a evaluar: ";
	Leer num;
	
	Si num > 0 Entonces
		Escribir "El Número ingresado en positivo y es:", num ,;
	FinSi
	Si num < 0 Entonces
		Escribir "El número ingresado es negativo y es:", num ,;
		
	FinSi
	Escribir "Fin del Programa."
FinAlgoritmo
